  cite_authors = {LIGO Scientific, Virgo and KAGRA Collaborations},
  title = {{Black Hole Spectroscopy and Tests of General Relativity with GW250114}},
  journal = {Physical Review Letters},
  year = {2026},
  volume = {136},
  number = {4},
  pages = {041403},
  eid = {041403},
  doi = {10.1103/6c61-fm1n},
