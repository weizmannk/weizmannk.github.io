  cite_authors = {LIGO Scientific, Virgo and KAGRA Collaborations},
  title = {{GW250114: Testing Hawking's Area Law and the Kerr Nature of Black Holes}},
  journal = {Physical Review Letters},
  year = {2025},
  volume = {135},
  number = {11},
  pages = {111403},
  eid = {111403},
