  eprint = {2410.16565},
  archiveprefix = {arXiv},
  publication_type = {collaboration},
  abstract = {{We present the results of a search for gravitational-wave transients
associated with core-collapse supernova SN 2023ixf, which was
observed in the galaxy Messier 101 via optical emission on 2023
May 19, during the LIGO─Virgo─KAGRA 15th Engineering Run. We
define a five-day on-source window during which an accompanying
gravitational-wave signal may have occurred. No gravitational
waves have been identified in data when at least two
gravitational-wave observatories were operating, which covered
{\ensuremath{\sim}}14\% of this five-day window. We report the
search detection efficiency for various possible gravitational-
wave emission models. Considering the distance to M101 (6.7
Mpc), we derive constraints on the gravitational-wave emission
mechanism of core-collapse supernovae across a broad frequency
spectrum, ranging from 50 Hz to 2 kHz, where we assume the
gravitational-wave emission occurred when coincident data are
available in the on-source window. Considering an ellipsoid
model for a rotating proto-neutron star, our search is sensitive
to gravitational-wave energy 1 {\texttimes}
10$^{{\ensuremath{-}}4}$ M$_{{\ensuremath{\odot}}}$c$^{2}$ and
luminosity 2.6 {\texttimes} 10$^{{\ensuremath{-}}4}$
M$_{{\ensuremath{\odot}}}$c$^{2}$ s$^{{\ensuremath{-}}1}$ for a
source emitting at 82 Hz. These constraints are around an order
of magnitude more stringent than those obtained so far with
gravitational-wave data. The constraint on the ellipticity of
the proto-neutron star that is formed is as low as 1.08, at
frequencies above 1200 Hz, surpassing past results.}},
  adsnote = {Provided by the SAO/NASA Astrophysics Data System},
  adsurl = {https://ui.adsabs.harvard.edu/abs/2025ApJ...985..183A},
  order = {28},
  primaryclass = {astro-ph.HE}
}

@article{lvk2025_swift_bat_guano,
  author = {{Raman}, Gayathri and {Ronchini}, Samuele and {Delaunay}, James and {Tohuvavohu}, Aaron and {Kennea}, Jamie A. and {Parsotan}, Tyler and {Ambrosi}, Elena and {Bernardini}, Maria Grazia and {Campana}, Sergio and {Cusumano}, Giancarlo and {D'A{\`\i}}, Antonino and {D'Avanzo}, Paolo and {D'Elia}, Valerio and {de Pasquale}, Massimiliano and {Dichiara}, Simone and {Evans}, Phil and {Hartmann}, Dieter and {Kuin}, Paul and {Melandri}, Andrea and {O'Brien}, Paul and {Osborne}, Julian P. and {Page}, Kim and {Palmer}, David M. and {Sbarufatti}, Boris and {Tagliaferri}, Gianpiero and {Troja}, Eleonora and {The Ligo Scientific Collaboration},, The VIRGO Collaboration and {The Kagra Collaboration} and {Abac}, A.~G. and {Abbott}, R. and {Abe}, H. and {Abouelfettouh}, I. and {Acernese}, F. and {Ackley}, K. and {Adamcewicz}, C. and {Adhicary}, S. and {Adhikari}, N. and {Adhikari}, R.~X. and {Adkins}, V.~K. and {Adya}, V.~B. and {Affeldt}, C. and {Agarwal}, D. and {Agathos}, M. and {Aguiar}, O.~D. and {Aguilar}, I. and {Aiello}, L. and {Ain}, A. and {Akutsu}, T. and {Albanesi}, S. and {Alfaidi}, R.~A. and {Al-Jodah}, A. and {All{\'e}n{\'e}}, C. and {Allocca}, A. and {Al-Shammari}, S. and {Altin}, P.~A. and {Alvarez-Lopez}, S. and {Amato}, A. and {Amez-Droz}, L. and {Amorosi}, A. and {Amra}, C. and {Anand}, S. and {Ananyeva}, A. and {Anderson}, S.~B. and {Anderson}, W.~G. and {Andia}, M. and {Ando}, M. and {Andrade}, T. and {Andres}, N. and {Andr{\'e}s-Carcasona}, M. and {Andri{\'c}}, T. and {Anglin}, J. and {Ansoldi}, S. and {Antelis}, J.~M. and {Antier}, S. and {Aoumi}, M. and {Appavuravther}, E.~Z. and {Appert}, S. and {Apple}, S.~K. and {Arai}, K. and {Araya}, A. and {Araya}, M.~C. and {Areeda}, J.~S. and {Aritomi}, N. and {Armato}, F. and {Arnaud}, N. and {Arogeti}, M. and {Aronson}, S.~M. and {Ashton}, G. and {Aso}, Y. and {Assiduo}, M. and {Assis de Souza Melo}, S. and {Aston}, S.~M. and {Astone}, P. and {Aubin}, F. and {Aultoneal}, K. and {Avallone}, G. and {Babak