  cite_authors = {LIGO Scientific, Virgo and KAGRA Collaborations},
  title = {{Ultralight vector dark matter search using data from the KAGRA O3GK run}},
  journal = {Physical Review D},
  year = {2024},
  volume = {110},
  number = {4},
  pages = {042001},
