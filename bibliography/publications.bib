  cite_authors = {LIGO Scientific, Virgo and KAGRA Collaborations},
  title = {{Searches for Continuous Gravitational Waves from Supernova Remnants in the First Part of the LIGO-Virgo-KAGRA Fourth Observing Run}},
  journal = {The Astrophysical Journal},
  year = {2026},
  volume = {1004},
  number = {2},
  pages = {204},
  eid = {204},
  doi = {10.3847/1538-4357/ae6263},
  eprint = {2603.25808},
